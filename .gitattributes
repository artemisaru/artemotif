# Set default behavior for text files
* text=auto

# Use LF (Unix style) line endings for code
*.scss text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.md   text eol=lf

# Binary files – prevent Git from messing with them
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary